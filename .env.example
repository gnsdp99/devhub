# cp .env.example .env 후 사용. 운영 환경에서는 반드시 다른 값으로 바꾼다.
POSTGRES_DB=devhub
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub

# 수집 스케줄러
DEVHUB_COLLECT_ENABLED=false
# 수집 주기와 저장 윈도우. ISO-8601 Duration.
DEVHUB_COLLECT_INTERVAL=PT30M
DEVHUB_COLLECT_WINDOW=P30D
# 동시에 가져올 피드 수
DEVHUB_COLLECT_CONCURRENCY=8

# 피드 HTTP 요청
DEVHUB_COLLECT_HTTP_CONNECT_TIMEOUT=5s
DEVHUB_COLLECT_HTTP_READ_TIMEOUT=10s
DEVHUB_COLLECT_HTTP_MAX_BODY_SIZE=10MB
DEVHUB_COLLECT_HTTP_MAX_REDIRECTS=5
